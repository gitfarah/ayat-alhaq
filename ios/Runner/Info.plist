<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Your location is used to calculate accurate prayer times and the Qiblah direction for your area. يُستخدم موقعك لحساب مواقيت الصلاة واتجاه القبلة في منطقتك.</string>
	<!-- The app only ever asks for location while it is in use; this key
	     exists because the location library also references the
	     "always" API, which App Store validation requires a string for. -->
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Your location is used only while you are using the app, to calculate prayer times and the Qiblah direction. It is never tracked in the background. يُستخدم موقعك أثناء استخدام التطبيق فقط لحساب مواقيت الصلاة واتجاه القبلة، ولا يُتتبَّع في الخلفية.</string>
	<!-- The app never records audio. This string is required because the
	     audio-playback framework used for recitation references the
	     microphone APIs of AVAudioSession. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>This app does not record audio. This permission is only referenced by the audio playback framework used for Quran recitation. لا يسجّل هذا التطبيق أي صوت؛ هذا الإذن مطلوب فقط من مكتبة تشغيل التلاوة.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<!-- Export compliance: the app uses only standard HTTPS (exempt
	     encryption), so App Store uploads won't prompt for the
	     encryption question. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>CFBundleLocalizations</key>
	<array>
		<string>ar</string>
		<string>en</string>
		<string>de</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>آيات الحق</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>quran_app_v1</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
